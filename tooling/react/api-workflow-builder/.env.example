# Copy this file to .env and fill in real values (or leave empty and use the
# Profiles UI in the app to enter them manually).
#
# The `.env` file is gitignored — no real credentials ever get committed.
# `.env.example` IS committed so teammates know which keys the tool expects.
#
# The dev server (server/index.ts) reads these ONLY to power the "Import from .env"
# button on the Profiles page. After that, credentials live per-profile in the
# browser's localStorage and never touch the repo.

# --- Corti OAuth client credentials ------------------------------------------
# Get these from the Corti Console for the project you want to test against.
CORTI_CLIENT_ID=
CORTI_CLIENT_SECRET=

# --- Region + tenant ---------------------------------------------------------
# CORTI_ENVIRONMENT_ID: eu | us (defaults to eu when unset)
CORTI_ENVIRONMENT_ID=eu

# CORTI_TENANT_NAME: your tenant name within Corti's multi-tenant system.
# "base" is the default for most personal / development projects.
CORTI_TENANT_NAME=base

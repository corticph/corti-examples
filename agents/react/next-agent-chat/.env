# Corti API Configuration
# Get your credentials from https://console.corti.app

# Your Corti tenant name (e.g., "my-organization")
TENANT=your-tenant-name

# OAuth client ID for machine-to-machine authentication
CLIENT_ID=your-client-id

# OAuth client secret (keep this secure, never commit to version control)
CLIENT_SECRET=your-client-secret

# Corti environment: "eu" (Europe) or "us" (United States)
ENVIRONMENT=eu

# HMAC secret used to verify scope tokens minted by rag-ui-corti.
# This MUST be identical to MCP_SCOPE_SECRET in rag-ui-corti/.env, or every token
# is rejected and retrieval falls back to shared docs only.
MCP_SCOPE_SECRET=dev-shared-secret-change-me

# Port for the HTTP server (npm run start:http). Defaults to 3000 if unset.
PORT=3000

# REQUIRED. HMAC secret used to verify scope tokens minted by rag-ui-corti.
# Must be identical to MCP_SCOPE_SECRET in rag-ui-corti/.env, or every token is
# rejected and retrieval falls back to shared docs only. The server refuses to
# start if this is unset (no default, so tokens can't be forged with a guessable
# key). Generate one with: openssl rand -hex 32
MCP_SCOPE_SECRET=

# Port for the HTTP server (npm run start:http). Defaults to 3000 if unset.
PORT=3000

# Enables the HTTP /ingest endpoint (used by rag-ui-corti's upload page). Disabled
# by default so tunneling the server doesn't expose an unauthenticated writable
# endpoint. Set to "true" only when you need uploads, and never expose /ingest
# publicly without restricting access. The CLI (npm run ingest) is unaffected.
ALLOW_INGEST=false

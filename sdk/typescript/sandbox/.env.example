# Corti credentials — read by the LOCAL SERVER only (never bundled into the
# browser). Each user supplies their own (BYO per-user); usage bills to your
# own tenant. The browser receives only the cluster/tenant (non-secret) and
# short-lived, streaming-only tokens.
#
# Use a non-prod cluster + disposable tenant for testing — driving the flows
# performs real writes (interactions, recordings, transcripts).
CORTI_CLIENT_ID=your-client-id
CORTI_CLIENT_SECRET=your-client-secret
CORTI_ENVIRONMENT=dev-weu
CORTI_TENANT_NAME=your-tenant

# Optional: client-side debug flag (exposed to the browser via Vite).
# VITE_DEBUG=true

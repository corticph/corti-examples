# Dependency resolution
legacy-peer-deps=true

# Security settings
# Ensure packages come from official registry only
registry=https://registry.npmjs.org/

# Require lock file to exist and be in sync
package-lock=true


# Prevent arbitrary script execution from dependencies
# Note: Some packages (e.g., @swc/core) need postinstall for native binaries.
# If you enable this, run `npm rebuild` after install for those packages.
# ignore-scripts=true

# Audit settings
audit=true
audit-level=high
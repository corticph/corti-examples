{
  "name": "corti-sdk-sandbox",
  "version": "0.4.0",
  "description": "Browser-based local tester for Corti's Speech-to-Text APIs (transcribe / streams / transcripts).",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "bin": {
    "corti-sdk-sandbox": "bin/cli.mjs"
  },
  "files": [
    "dist",
    "bin",
    ".env.example"
  ],
  "engines": {
    "node": ">=18"
  },
  "pkg": {
    "assets": [
      "dist/spa/*"
    ],
    "scripts": [
      "dist/server/**/*.js"
    ]
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run build:client && npm run build:server",
    "build:client": "vite build",
    "build:server": "vite build --config vite.config.server.ts",
    "start": "node dist/server/node-build.mjs",
    "test": "vitest --run",
    "lint": "biome check client/ server/",
    "format.fix": "biome check --write client/ server/",
    "typecheck": "tsc",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "axios": "^1.18.0",
    "dotenv": "17.4.2",
    "express": "^5.2.1",
    "http-proxy-middleware": "4.1.1"
  },
  "overrides": {
    "@corti/sdk": "6.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.6",
    "@corti/ambient-web": "latest",
    "@corti/dictation-web": "latest",
    "@corti/sdk": "6.0.0",
    "@hookform/resolvers": "5.4.0",
    "@lit/react": "^1.0.8",
    "@radix-ui/react-accordion": "1.2.13",
    "@radix-ui/react-alert-dialog": "1.1.16",
    "@radix-ui/react-aspect-ratio": "1.1.9",
    "@radix-ui/react-avatar": "1.1.12",
    "@radix-ui/react-checkbox": "1.3.4",
    "@radix-ui/react-collapsible": "1.1.13",
    "@radix-ui/react-context-menu": "2.3.0",
    "@radix-ui/react-dialog": "1.1.16",
    "@radix-ui/react-dropdown-menu": "2.1.17",
    "@radix-ui/react-hover-card": "1.1.16",
    "@radix-ui/react-label": "2.1.9",
    "@radix-ui/react-menubar": "1.1.17",
    "@radix-ui/react-navigation-menu": "1.2.15",
    "@radix-ui/react-popover": "1.1.16",
    "@radix-ui/react-progress": "1.1.9",
    "@radix-ui/react-radio-group": "1.4.0",
    "@radix-ui/react-scroll-area": "1.2.11",
    "@radix-ui/react-select": "2.3.0",
    "@radix-ui/react-separator": "1.1.9",
    "@radix-ui/react-slider": "1.4.0",
    "@radix-ui/react-slot": "1.2.5",
    "@radix-ui/react-switch": "1.3.0",
    "@radix-ui/react-tabs": "1.1.14",
    "@radix-ui/react-toast": "1.2.16",
    "@radix-ui/react-toggle": "1.1.11",
    "@radix-ui/react-toggle-group": "1.1.12",
    "@radix-ui/react-tooltip": "1.2.9",
    "@react-three/fiber": "^9.6.1",
    "@swc/core": "1.15.41",
    "@tailwindcss/typography": "0.5.20",
    "@tanstack/react-query": "5.101.0",
    "@types/express": "5.0.6",
    "@types/node": "25.9.3",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@types/w3c-web-hid": "1.0.7",
    "@vitejs/plugin-react-swc": "4.3.1",
    "autoprefixer": "10.5.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "dictation_support": "^1.0.5",
    "globals": "17.6.0",
    "jsdom": "^29.1.1",
    "lucide-react": "1.18.0",
    "mermaid": "^11.16.0",
    "next-themes": "0.4.6",
    "postcss": "^8.5.15",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-hook-form": "7.79.0",
    "react-router-dom": "^7.17.0",
    "react-syntax-highlighter": "^16.1.1",
    "recharts": "^3.8.1",
    "serverless-http": "4.0.0",
    "sonner": "2.0.7",
    "tailwind-merge": "3.6.0",
    "tailwindcss": "^3.4.17",
    "tailwindcss-animate": "1.0.7",
    "three": "^0.185.1",
    "tsx": "^4.22.4",
    "typescript": "6.0.3",
    "vite": "^6.4.2",
    "vitest": "4.1.9"
  }
}

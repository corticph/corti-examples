{
    "commands": [
      {
        "id": "navigate_fields",
        "phrases": ["{choice} {location}"],
        "variables": [
          {
            "key": "choice",
            "type": "enum",
            "enum": ["next", "previous", "prior", "first", "last"]
          },
          {
            "key": "location",
            "type": "enum",
            "enum": ["field", "section", "control"]
          }
        ]
      },
      {
        "id": "go_to",
        "phrases": ["go to {choice} of {location}"],
        "variables": [
          {
            "key": "choice",
            "type": "enum",
            "enum": ["beginning", "start", "end"]
          },
          {
            "key": "location",
            "type": "enum",
            "enum": ["line", "paragraph", "document"]
          }
        ]
      },
      {
        "id": "insert_cursor",
        "phrases": ["insert {direction} {choice} {location}"],
        "variables": [
          {
            "key": "direction",
            "type": "enum",
            "enum": ["before", "after"]
          },
          {
            "key": "choice",
            "type": "enum",
            "enum": ["current", "first", "last", "previous", "prior", "next"]
          },
          {
            "key": "location",
            "type": "enum",
            "enum": ["line", "word", "paragraph", "document"]
          }
        ]
      }
    ]
}
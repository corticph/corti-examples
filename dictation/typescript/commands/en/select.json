{
    "commands": [
      {
        "id": "select",
        "phrases": ["select {selection}"],
        "variables": [
          {
            "key": "selection",
            "type": "enum",
            "enum": ["all", "that"]
          }
        ]
      },
      {
        "id": "unselect",
        "phrases": ["unselect {selection}", "deselect {selection}", "clear selection"],
        "variables": [
          {
            "key": "selection",
            "type": "enum",
            "enum": ["all", "that", "text"]
          }
        ]
      },
      {
        "id": "select_that",
        "phrases": [
          "select {choice} {selection}"
        ],
        "variables": [
          {
            "key": "choice",
            "type": "enum",
            "enum": ["current", "first", "last", "previous", "prior", "next"]
          },
          {
            "key": "selection",
            "type": "enum",
            "enum": ["word", "sentence", "paragraph"]
          }
        ]
      },
      {
        "id": "select_n",
        "phrases": [
          "select {choice} {n} words, select {choice} {n} word"
        ],
        "variables": [
          {
            "key": "choice",
            "type": "enum",
            "enum": ["current", "first", "last", "previous", "prior", "next"]
          },
          {
            "key": "n",
            "type": "enum",
            "enum": ["one", "two", "three", "four", "five", "six", "seven", "eight", "nine", "ten"]
          }
        ]
    }
    ]
}
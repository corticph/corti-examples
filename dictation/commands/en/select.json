{
    "commands": [
      {
        "id": "select",
        "phrases": ["select {selection}"],
        "variables": [
          {
            "key": "selection",
            "type": "enum",
            "enum": ["all", "that"]
          }
        ]
      },
      {
        "id": "unselect",
        "phrases": ["unselect {selection}", "deselect {selection}", "clear selection"],
        "variables": [
          {
            "key": "selection",
            "type": "enum",
            "enum": ["all", "that", "text"]
          }
        ]
      },
      {
        "id": "select_that",  
        "phrases": ["select {choice} {selection}"],
        "variables": [
          {
            "key": "choice",
            "type": "enum",
            "enum": ["current", "first", "last", "previous", "prior", "next"]
          },
          {
            "key": "selection",
            "type": "enum",
            "enum": ["word", "sentence", "paragraph"]
          }
        ]
      },
      {
        "id": "select_number_of_words",
        "phrases": ["select {choice} {number} words", "select {choice} {number} word"],
        "variables": [
          {
            "key": "choice",
            "type": "enum",
            "enum": ["current", "first", "last", "previous", "prior", "next"]
          },
          {
            "key": "number",
            "type": "enum",
            "enum": ["one", "two", "three", "four", "five", "six", "seven", "eight", "nine", "ten"]
          }
        ]
      },
      {
        "id": "select_number",
        "phrases": ["select {choice} {number}", "select {choice} {ordinal}, pick {number}, pick {ordinal}"],
        "variables": [
          {
            "key": "choice",
            "type": "enum",
            "enum": ["choice", "option", "number", "item"]
          },
          {
            "key": "number",
            "type": "enum",
            "enum": ["one", "two", "three", "four", "five"]
          },
          {
            "key": "ordinal",
            "type": "enum",
            "enum": ["first", "second", "third", "fourth", "fifth"]
          }
        ]
      }
    ]
}
# Copy this file to .env for local development.
# Keep server-only secrets here as the app grows.

EHR_SQLITE_PATH=./data/ehr-demo.sqlite

# Corti embedded assistant server configuration.
CORTI_ENVIRONMENT=eu
CORTI_TENANT_NAME=base
CORTI_CLIENT_ID=your_client_id_here
CORTI_USER_EMAIL=user@example.com
CORTI_USER_PASSWORD=secure_password_here